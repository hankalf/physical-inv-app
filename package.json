{
  "name": "physical-inv-app",
  "version": "1.0.0",
  "private": true,
  "description": "Physical inventory counting for Zebra handheld scanners",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/server.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch src/server.js",
    "test": "node tests/run-all.mjs",
    "test:one": "node tests/run-all.mjs",
    "docs:shots": "node tools/sop-shots.mjs",
    "docs:pdf": "node tools/sop-pdf.mjs",
    "docs:guides": "node tools/sop-pdf.mjs --roles && node tools/sop-pdf.mjs --guides",
    "docs": "npm run docs:shots && npm run docs:pdf && npm run docs:guides",
    "video": "node tools/gun-video.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
